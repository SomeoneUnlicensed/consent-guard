{
  "name": "consent-guard",
  "version": "0.1.0",
  "description": "Anti-scraper / anti-AI-agent protection with counter-injection: unauthorized clients get an authoritative cease notice from the site owner.",
  "type": "module",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/SomeoneUnlicensed/consent-guard.git"
  },
  "keywords": [
    "security",
    "waf",
    "anti-scraper",
    "anti-bot",
    "ai-crawler",
    "gptbot",
    "claudebot",
    "counter-injection",
    "prompt-injection",
    "rate-limit",
    "nextjs",
    "express"
  ],
  "exports": {
    ".": "./dist/index.js",
    "./express": "./dist/adapters/express.js",
    "./next": "./dist/adapters/next.js"
  },
  "bin": {
    "consent-guard": "./dist/cli/index.js"
  },
  "files": [
    "dist",
    "static"
  ],
  "scripts": {
    "build": "tsc && node scripts/copy-static.js",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "lint": "tsc --noEmit",
    "demo": "npm run build && node demo/server.mjs",
    "banner": "node scripts/make-gif.mjs"
  },
  "devDependencies": {
    "@types/node": "^24.10.1",
    "typescript": "^5.9.3",
    "vitest": "^4.0.18"
  }
}
